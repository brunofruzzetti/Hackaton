# --- LLM (vecinos IA + juez) ---
DEEPSEEK_API_KEY=

# --- LiveKit (audio WebRTC) ---
# Cloud: wss://tu-proyecto.livekit.cloud  |  Local: ws://localhost:7880
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- STT (transcripción de clips) ---
# openai | deepgram | mock (mock = desarrollo sin claves)
STT_PROVIDER=openai
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# --- Servidor ---
PORT=3001
# Silenciar micros 3s cuando el juez interviene (Hito 5)
JUDGE_FORCE_MUTE=true

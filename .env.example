# Servidor
PORT=3001

# URL pública para el QR (opcional). Si está vacía, el cliente usa la IP LAN
# detectada por el servidor. Para audio en móvil conviene un túnel HTTPS:
# PUBLIC_URL=https://tu-tunel.example
PUBLIC_URL=

# LiveKit (audio de la junta). Si falta, el juego funciona solo con chat.
LIVEKIT_URL=ws://localhost:7880
# URL que recibirá el móvil. Si usas la LAN, puedes dejarla vacía y el servidor
# reescribirá localhost por la IP del navegador.
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Supabase Realtime (opcional). Ejecuta supabase/schema.sql antes.
# El servidor usa la service role para espejar el estado; el cliente usa la anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Cliente (Vite). Deben empezar por VITE_ para exponerse al navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
